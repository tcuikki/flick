{
  "name": "flick",
  "version": "1.0.0",
  "description": "開いた瞬間メモできる、フリックで動かすタスク管理",
  "scripts": {
    "dev": "vite",
    "dev:mock": "npm run db:migrate:mock && CLOUDFLARE_ENV=e2e vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply flick-db --local",
    "db:migrate:mock": "wrangler d1 migrations apply flick-db-e2e --local --env e2e",
    "db:migrate:remote": "wrangler d1 migrations apply flick-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
