{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flick",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flick-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  // メールの更新：5分ごと（画面を開いている間は、画面からも1分ごとに読み込む）
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // 大学（Outlook）のテナント。アプリ登録を大学のアカウントで「この組織のみ」にした場合は大学のドメイン
    "MS_TENANT": "tcu.ac.jp"
  },
  // E2E テスト専用環境（CLOUDFLARE_ENV=e2e）。Cloudflare に接続せずローカルだけで動く。
  // AI はモック、ログインはテスト用エンドポイント。本番デプロイには使わない。
  "env": {
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flick-db-e2e",
          "database_id": "00000000-0000-0000-0000-0000000000e2",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_MODEL": "mock",
        "E2E": "1",
        "GOOGLE_CLIENT_ID": "e2e-client-id.apps.googleusercontent.com",
        "GOOGLE_CLIENT_SECRET": "e2e-secret"
      }
    }
  }
}
